<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,
      maximum-scale=1,user-scalable=no">

<title>EVOKID X</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
  background:#050509;
  font-family:Arial,sans-serif;
  color:white;
}

/* NÚT X NGOÀI */
#launcher{
  position:fixed;
  right:22px;
  bottom:28px;
  width:62px;
  height:62px;
  border-radius:50%;
  border:2px solid #ff3030;
  background:#11080a;
  color:#ff3030;
  font-size:28px;
  font-weight:900;
  z-index:9999999;
  box-shadow:
    0 0 12px #ff2020,
    0 0 35px #ff202066;
}

#launcher:active{
  transform:scale(.92);
}

/* LỚP MENU */
#overlay{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:999999;
}

/* MENU */
#menu{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:min(94vw,620px);
  max-height:90vh;
  overflow:auto;

  border:1px solid #7c27ff;
  border-radius:16px;

  background:
    radial-gradient(circle at 15% 5%,#32105d,transparent 35%),
    radial-gradient(circle at 90% 90%,#062b38,transparent 40%),
    #08060d;

  box-shadow:
    0 0 18px #7c27ff,
    0 0 55px #401080aa;

  pointer-events:auto;
  display:none;
}

#menu.open{
  display:block;
}

/* HEADER */
.header{
  padding:14px 16px;
  background:
    linear-gradient(
      90deg,
      #160a22,
      #24102f,
      #11091c
    );
  border-bottom:1px solid #ffffff18;
  position:relative;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
}

.dragon{
  font-size:34px;
  filter:
    drop-shadow(0 0 5px #ffb300)
    drop-shadow(0 0 12px #ff8c00);
}

.title{
  font-size:18px;
  font-weight:900;
  letter-spacing:.5px;
}

.subtitle{
  color:#8d8298;
  font-size:9px;
  margin-top:3px;
}

.close{
  position:absolute;
  right:12px;
  top:12px;
  border:0;
  background:none;
  color:#ddd;
  font-size:24px;
}

/* TABS */
.tabs{
  display:flex;
  gap:6px;
  padding:10px;
}

.tab{
  flex:1;
  border:1px solid #ffffff14;
  border-radius:7px;
  background:#ffffff07;
  color:#888;
  padding:9px 4px;
  font-size:10px;
  font-weight:bold;
}

.tab.active{
  color:white;
  border-color:#8b42ff;
  background:#762cff33;
  box-shadow:0 0 10px #762cff55;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  padding:0 10px 10px;
}

.panel{
  border:1px solid #ffffff12;
  border-radius:10px;
  background:#00000035;
  overflow:hidden;
}

.panel-title{
  padding:9px 10px 6px;
  color:#9e7cff;
  font-size:9px;
  font-weight:bold;
  letter-spacing:1px;
}

/* ROW */
.row{
  min-height:40px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  padding:7px 10px;
  font-size:11px;
}

.row span:first-child{
  color:#ddd;
}

/* SWITCH */
.switch{
  flex:none;
  width:34px;
  height:19px;
  border-radius:20px;
  background:#302a38;
  position:relative;
  transition:.15s;
}

.switch:after{
  content:"";
  position:absolute;
  width:15px;
  height:15px;
  left:2px;
  top:2px;
  border-radius:50%;
  background:#777;
  transition:.15s;
}

.switch.on{
  background:linear-gradient(
    90deg,
    #7b25ff,
    #a735ff
  );
  box-shadow:0 0 8px #862cff88;
}

.switch.on:after{
  left:17px;
  background:white;
}

/* SLIDER */
.sliderbox{
  margin:0 10px 12px;
  padding:10px;
  border-radius:8px;
  background:#0005;
}

.slider-title{
  display:flex;
  justify-content:space-between;
  font-size:10px;
  color:#aaa;
  margin-bottom:8px;
}

input[type=range]{
  width:100%;
  accent-color:#8d38ff;
}

/* STATUS */
.status{
  margin:0 10px 12px;
  padding:9px;
  border-radius:8px;
  background:#0007;
  color:#75dfff;
  font-size:10px;
  text-align:center;
}

/* MOBILE */
@media(max-width:520px){
  #menu{
    width:94vw;
    max-height:84vh;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .row{
    min-height:38px;
  }

  .title{
    font-size:16px;
  }

  .dragon{
    font-size:30px;
  }
}

/* RẤT NHỎ */
@media(max-width:360px){
  #menu{
    width:96vw;
  }

  .row{
    font-size:10px;
  }
}
</style>
</head>

<body>

<button id="launcher">X</button>

<div id="overlay">

  <div id="menu">

    <div class="header">

      <div class="logo">
        <div class="dragon">🐉</div>

        <div>
          <div class="title">
            EVOKID X
          </div>

          <div class="subtitle">
            MOBILE CONTROL PANEL
          </div>
        </div>
      </div>

      <button class="close" id="close">
        ×
      </button>

    </div>

    <div class="tabs">

      <button class="tab active"
              data-tab="main">
        VISUAL
      </button>

      <button class="tab"
              data-tab="combat">
        COMBAT
      </button>

      <button class="tab"
              data-tab="utility">
        UTILITY
      </button>

    </div>

    <div class="grid">

      <!-- VISUAL -->

      <div class="panel">

        <div class="panel-title">
          VISUALS
        </div>

        <div class="row">
          <span>Visual CD Timer</span>
          <div class="switch on"
               data-name="cd"></div>
        </div>

        <div class="row">
          <span>Blaze Perfect Arc</span>
          <div class="switch on"
               data-name="arc"></div>
        </div>

        <div class="row">
          <span>Draw Target Lines</span>
          <div class="switch on"
               data-name="lines"></div>
        </div>

        <div class="row">
          <span>Show Hitboxes</span>
          <div class="switch on"
               data-name="hitboxes"></div>
        </div>

      </div>


      <!-- COMBAT -->

      <div class="panel">

        <div class="panel-title">
          COMBAT AUTOMATION
        </div>

        <div class="row">
          <span>Timer Low Lv</span>
          <div class="switch on"
               data-name="timer"></div>
        </div>

        <div class="row">
          <span>True AI Punish</span>
          <div class="switch"
               data-name="punish"></div>
        </div>

        <div class="row">
          <span>Predator Aim</span>
          <div class="switch"
               data-name="aim"></div>
        </div>

        <div class="row">
          <span>Auto-Dodge</span>
          <div class="switch"
               data-name="dodge"></div>
        </div>

        <div class="row">
          <span>Auto-Sprint</span>
          <div class="switch"
               data-name="sprint"></div>
        </div>

        <div class="row">
          <span>Auto-Hunt</span>
          <div class="switch"
               data-name="hunt"></div>
        </div>

        <div class="row">
          <span>Auto-Attack</span>
          <div class="switch"
               data-name="attack"></div>
        </div>

      </div>

    </div>


    <!-- UTILITY -->

    <div class="panel"
         style="margin:0 10px 10px">

      <div class="panel-title">
        MODIFIERS & UTILITY
      </div>

      <div class="row">
        <span>Camera Zoom</span>
        <b id="zoomValue">1.00</b>
      </div>

      <div class="sliderbox">

        <input
          id="zoom"
          type="range"
          min="0.5"
          max="2"
          step="0.05"
          value="1">

      </div>

    </div>


    <div class="status">

      MENU: ON
      &nbsp; • &nbsp;
      STATUS: READY

    </div>

  </div>

</div>


<script>

const launcher =
  document.getElementById("launcher");

const menu =
  document.getElementById("menu");

const close =
  document.getElementById("close");


/* MỞ MENU */

launcher.onclick = () => {

  menu.classList.toggle("open");

  launcher.textContent =
    menu.classList.contains("open")
    ? "×"
    : "X";

};


/* ĐÓNG */

close.onclick = () => {

  menu.classList.remove("open");

  launcher.textContent="X";

};


/* SWITCH */

document
.querySelectorAll(".switch")
.forEach(sw => {

  sw.addEventListener("click",() => {

    sw.classList.toggle("on");

  });

});


/* TABS */

document
.querySelectorAll(".tab")
.forEach(tab => {

  tab.addEventListener("click",() => {

    document
    .querySelectorAll(".tab")
    .forEach(x =>
      x.classList.remove("active")
    );

    tab.classList.add("active");

  });

});


/* CAMERA ZOOM */

const zoom =
  document.getElementById("zoom");

const zoomValue =
  document.getElementById("zoomValue");

zoom.addEventListener("input",() => {

  zoomValue.textContent =
    Number(zoom.value).toFixed(2);

});


/* KÉO MENU TRÊN ĐIỆN THOẠI */

let dragging=false;
let startX=0;
let startY=0;
let menuX=0;
let menuY=0;

const header =
  document.querySelector(".header");

header.addEventListener(
  "pointerdown",
  e => {

    dragging=true;

    const r =
      menu.getBoundingClientRect();

    menu.style.transform="none";

    menuX=r.left;
    menuY=r.top;

    startX=e.clientX;
    startY=e.clientY;

    header.setPointerCapture(
      e.pointerId
    );

  }
);

header.addEventListener(
  "pointermove",
  e => {

    if(!dragging)return;

    menu.style.left =
      (menuX+
       e.clientX-
       startX)+"px";

    menu.style.top =
      (menuY+
       e.clientY-
       startY)+"px";

  }
);

header.addEventListener(
  "pointerup",
  () => {

    dragging=false;

  }
);

</script>

</body>
</html>
