<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Cosmic X Menu</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  background:#05040c;
  color:#fff;
  font-family:Arial,sans-serif;
  min-height:100vh;
  overflow:hidden;
}

#starfield{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:1;
}

#menu{
  position:fixed;
  z-index:999;
  top:70px;
  left:18px;
  width:285px;
  border:2px solid #8d5cff;
  border-radius:18px;
  background:
    radial-gradient(circle at 20% 10%,#452080 0,transparent 35%),
    radial-gradient(circle at 90% 90%,#064c70 0,transparent 35%),
    #090617;
  box-shadow:0 0 25px #6f3cffaa,0 0 70px #00bfff33;
  overflow:hidden;
}

#head{
  padding:13px 15px;
  cursor:move;
  background:linear-gradient(90deg,#30135f,#111c4e,#30135f);
  border-bottom:1px solid #ffffff22;
}

.title{
  font-size:20px;
  font-weight:800;
}

.sub{
  font-size:10px;
  opacity:.6;
  margin-top:3px;
}

#close{
  float:right;
  background:none;
  border:0;
  color:#fff;
  font-size:22px;
}

.tabs{
  display:flex;
  gap:5px;
  padding:9px;
}

.tab{
  flex:1;
  border:1px solid #ffffff20;
  background:#ffffff0d;
  color:#aaa;
  padding:7px;
  border-radius:8px;
  font-size:11px;
}

.tab.active{
  color:#fff;
  border-color:#8d5cff;
  background:#6f3cff33;
}

.section{
  padding:5px 14px;
  color:#9ea9ff;
  font-size:10px;
  letter-spacing:1px;
}

.row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:9px 14px;
  font-size:13px;
}

.sw{
  width:40px;
  height:21px;
  border-radius:20px;
  background:#302b3d;
  position:relative;
}

.sw:after{
  content:"";
  position:absolute;
  width:17px;
  height:17px;
  top:2px;
  left:2px;
  border-radius:50%;
  background:#aaa;
  transition:.15s;
}

.sw.on{
  background:linear-gradient(90deg,#7b3cff,#00cfff);
}

.sw.on:after{
  left:21px;
  background:#fff;
}

#stats{
  margin:6px 12px 12px;
  padding:9px;
  border-radius:10px;
  background:#0005;
  font-size:11px;
  color:#8feaff;
}

body.clean #menu{
  box-shadow:none;
}

button{
  font-family:inherit;
}
</style>
</head>

<body>

<canvas id="starfield"></canvas>

<div id="menu">

  <div id="head">
    <button id="close">×</button>
    <div class="title">🌌 COSMIC X</div>
    <div class="sub">MOBILE CONTROL PANEL</div>
  </div>

  <div class="tabs">
    <button class="tab active" data-tab="visual">VISUAL</button>
    <button class="tab" data-tab="utility">UTILITY</button>
    <button class="tab" data-tab="settings">SETTINGS</button>
  </div>

  <div id="content"></div>

  <div id="stats">
    FPS: <b id="fps">--</b>
    • MENU: <b>ON</b>
  </div>

</div>

<script>

const state={
  fps:true,
  stars:true,
  dark:true,
  compact:false,
  grid:false,
  sound:true,
  drag:true
};

const groups={

  visual:[
    ["fps","⚡ FPS Counter"],
    ["stars","✨ Star Effects"],
    ["grid","▦ Grid Overlay"]
  ],

  utility:[
    ["compact","📱 Compact Mode"],
    ["sound","🔊 UI Sound"],
    ["drag","🖐️ Drag Menu"]
  ],

  settings:[
    ["dark","🌙 Dark Theme"]
  ]

};

const content=document.querySelector("#content");

function render(tab="visual"){

  content.innerHTML=
    '<div class="section">'+
    tab.toUpperCase()+
    '</div>';

  groups[tab].forEach(([key,label])=>{

    const row=document.createElement("div");
    row.className="row";

    row.innerHTML=
      `<span>${label}</span>
       <span class="sw ${state[key]?"on":""}"
       data-key="${key}"></span>`;

    row.querySelector(".sw").onclick=()=>{

      state[key]=!state[key];

      apply();
      render(tab);

    };

    content.appendChild(row);

  });

}

function apply(){

  document.body.classList.toggle(
    "clean",
    !state.stars
  );

  document.querySelector("#starfield").style.display=
    state.stars ? "block" : "none";

  document.querySelector("#menu").style.width=
    state.compact ? "245px" : "285px";
}

document.querySelectorAll(".tab").forEach(button=>{

  button.onclick=()=>{

    document
      .querySelectorAll(".tab")
      .forEach(x=>x.classList.remove("active"));

    button.classList.add("active");

    render(button.dataset.tab);

  };

});

render();
apply();


/* Kéo menu */

let dragging=false;
let dx=0;
let dy=0;

const head=document.querySelector("#head");
const menu=document.querySelector("#menu");

head.addEventListener("pointerdown",e=>{

  if(!state.drag)return;

  dragging=true;

  dx=e.clientX-menu.offsetLeft;
  dy=e.clientY-menu.offsetTop;

  head.setPointerCapture(e.pointerId);

});

head.addEventListener("pointermove",e=>{

  if(!dragging)return;

  menu.style.left=
    (e.clientX-dx)+"px";

  menu.style.top=
    (e.clientY-dy)+"px";

});

head.addEventListener("pointerup",()=>{
  dragging=false;
});


/* Nút đóng */

document.querySelector("#close").onclick=()=>{
  menu.style.display="none";
};


/* Sao */

const canvas=document.querySelector("#starfield");
const ctx=canvas.getContext("2d");

let stars=[];

function resize(){

  canvas.width=innerWidth;
  canvas.height=innerHeight;

  stars=Array.from(
    {length:120},
    ()=>({
      x:Math.random()*canvas.width,
      y:Math.random()*canvas.height,
      r:Math.random()*1.6
    })
  );

}

function draw(){

  ctx.clearRect(
    0,
    0,
    canvas.width,
    canvas.height
  );

  if(state.stars){

    ctx.fillStyle="#fff";

    stars.forEach(star=>{

      ctx.fillRect(
        star.x,
        star.y,
        star.r,
        star.r
